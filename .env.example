# Authentication is required in production. Keep real credentials in a secret
# manager and never commit them to the repository.
#
# APP_AUTH_USERS='[{"username":"admin","password":"replace-with-a-long-password","role":"admin"},{"username":"employee-001","password":"replace-with-a-long-password","role":"employee","employeeId":"EMP_001"}]'
APP_AUTH_USERS='[]'

# At least 32 random characters in production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET="replace-with-a-long-random-secret"

# Optional: store mutable application state on a persistent volume.
# RUNTIME_STATE_PATH="/var/lib/career-quest/runtime-state.json"
